# ==============================================================================
# Git Ignore — PORTALIS (Asesor de Puertas & Frontend)
# ==============================================================================

# Entorno de Agentes, Skills & Asistentes IA
.agents/
.gemini/
.system_generated/
.taste-skill/
scratch/

# Dependencias y Administradores de Paquetes
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Archivos de Entorno y Credenciales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Compilación y Salidas de Producción
dist/
build/
out/
.cache/
.parcel-cache/

# Registros (Logs) y Temporales
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# Sistema Operativo — Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Sistema Operativo — macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Editores y Entornos de Desarrollo (IDEs)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace